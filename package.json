{
  "name": "meditrack",
  "version": "1.0.0",
  "description": "A multi-tenant SaaS application for small clinics to manage patients, doctors, medical visit history, prescriptions, and follow-ups",
  "main": "src/app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "build:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/style.css --watch",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "seed": "node src/utils/seed.js",
    "setup": "npm install && npm run build:css",
    "setup:full": "npm run setup && npm run db:migrate && npm run seed",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "clinic",
    "saas",
    "medical",
    "healthcare"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.10",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "puppeteer": "^21.6.1",
    "sequelize": "^6.35.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.17",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.33",
    "sequelize-cli": "^6.6.3",
    "tailwindcss": "^3.4.1"
  }
}
