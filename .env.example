# ============================================
# MediTrack Environment Configuration
# ============================================
# Copy this file to .env and update with your values

# Server Configuration
# --------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Session Configuration
# --------------------
# Generate a strong secret: openssl rand -base64 32
SESSION_SECRET=your-super-secret-session-key-change-this-in-production-minimum-32-characters-long

# Database Configuration
# --------------------
# PostgreSQL (Recommended)
DATABASE_URL="postgresql://user:password@localhost:5432/meditrack?schema=public"

# MySQL Alternative (uncomment and update prisma/schema.prisma if using MySQL)
# DATABASE_URL="mysql://user:password@localhost:3306/meditrack"

# Redis Configuration (Optional - for production session storage)
# --------------------
# Uncomment and configure if using Redis for session storage
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# File Upload Configuration
# --------------------
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Email Configuration (Optional - for future email features)
# --------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@meditrack.com

# SMS/WhatsApp Configuration (Optional - for reminder features)
# --------------------
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1234567890
# WHATSAPP_API_KEY=your-whatsapp-api-key

# Security Configuration
# --------------------
# CORS_ORIGIN=http://localhost:3000
# TRUST_PROXY=false

# Logging Configuration
# --------------------
# LOG_LEVEL=info
# LOG_FILE=./logs/app.log
