# ============================================
# MediTrack Environment Configuration
# ============================================

# Server Configuration
NODE_ENV=development
PORT=3301
APP_URL=http://localhost:3301

# Session Configuration
# Generate using: openssl rand -base64 32
SESSION_SECRET=Y22ZcZmf6kRnqV7nTzaV14Wd7npXDNR0rwTD1POWHXw

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
POSTGRES_USER=meditrack
POSTGRES_PASSWORD=meditrack_password
POSTGRES_DB=meditrack

DATABASE_URL=postgresql://meditrack:meditrack_password@postgres:5432/meditrack?sslmode=disable

# ============================================
# Redis Configuration (Session / Cache)
# ============================================
REDIS_PASSWORD=meditrack_password
REDIS_URL=redis://:meditrack_password@redis:6379

# ============================================
# File Upload Configuration
# ============================================
MAX_FILE_SIZE=5242880
UPLOAD_DIR=/app/uploads

# ============================================
# Email Configuration (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@meditrack.com

# ============================================
# SMS / WhatsApp (Optional)
# ============================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
WHATSAPP_API_KEY=your-whatsapp-api-key

# ============================================
# Security Configuration
# ============================================
CORS_ORIGIN=http://localhost:3301
TRUST_PROXY=false

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log
