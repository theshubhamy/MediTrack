<div class="max-w-4xl mx-auto p-8 bg-white">
    <!-- Header -->
    <div class="mb-8 border-b-2 border-gray-300 pb-4">
        <div class="flex justify-between items-start">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">INVOICE</h1>
                <p class="text-sm text-gray-600">Invoice #<%= invoice.invoiceNumber %></p>
            </div>
            <div class="text-right">
                <p class="text-sm text-gray-600">Issue Date: <%= new Date(invoice.created_at).toLocaleDateString() %></p>
                <% if (invoice.dueDate) { %>
                    <p class="text-sm text-gray-600">Due Date: <%= new Date(invoice.dueDate).toLocaleDateString() %></p>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Clinic and Billing Info -->
    <div class="grid grid-cols-2 gap-8 mb-8">
        <div>
            <h3 class="text-sm font-semibold text-gray-700 mb-2">Bill To:</h3>
            <p class="font-semibold text-gray-900"><%= invoice.clinic.name %></p>
            <% if (invoice.clinic.address) { %>
                <p class="text-sm text-gray-700"><%= invoice.clinic.address %></p>
            <% } %>
            <% if (invoice.clinic.phone) { %>
                <p class="text-sm text-gray-700">Phone: <%= invoice.clinic.phone %></p>
            <% } %>
            <% if (invoice.clinic.email) { %>
                <p class="text-sm text-gray-700">Email: <%= invoice.clinic.email %></p>
            <% } %>
        </div>
        <div class="text-right">
            <h3 class="text-sm font-semibold text-gray-700 mb-2">Status:</h3>
            <span class="px-3 py-1 text-sm font-semibold rounded
                <%= invoice.status === 'PAID' ? 'bg-green-100 text-green-800' : '' %>
                <%= invoice.status === 'PENDING' ? 'bg-yellow-100 text-yellow-800' : '' %>
                <%= invoice.status === 'OVERDUE' ? 'bg-red-100 text-red-800' : '' %>">
                <%= invoice.status %>
            </span>
        </div>
    </div>

    <!-- Invoice Items -->
    <div class="mb-8">
        <table class="w-full border-collapse border border-gray-300">
            <thead>
                <tr class="bg-gray-100">
                    <th class="border border-gray-300 px-4 py-3 text-left text-sm font-semibold">Description</th>
                    <th class="border border-gray-300 px-4 py-3 text-right text-sm font-semibold">Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="border border-gray-300 px-4 py-3 text-sm">
                        <p class="font-medium text-gray-900"><%= invoice.plan %> Plan Subscription</p>
                        <% if (invoice.billingPeriodStart && invoice.billingPeriodEnd) { %>
                            <p class="text-xs text-gray-600 mt-1">
                                Period: <%= new Date(invoice.billingPeriodStart).toLocaleDateString() %> -
                                <%= new Date(invoice.billingPeriodEnd).toLocaleDateString() %>
                            </p>
                        <% } %>
                    </td>
                    <td class="border border-gray-300 px-4 py-3 text-sm text-right">
                        $<%= parseFloat(invoice.amount).toFixed(2) %>
                    </td>
                </tr>
                <% if (parseFloat(invoice.taxAmount) > 0) { %>
                    <tr>
                        <td class="border border-gray-300 px-4 py-3 text-sm text-gray-700">Tax</td>
                        <td class="border border-gray-300 px-4 py-3 text-sm text-right">
                            $<%= parseFloat(invoice.taxAmount).toFixed(2) %>
                        </td>
                    </tr>
                <% } %>
            </tbody>
            <tfoot>
                <tr class="bg-gray-50">
                    <td class="border border-gray-300 px-4 py-3 text-sm font-semibold text-gray-900">Total</td>
                    <td class="border border-gray-300 px-4 py-3 text-sm font-semibold text-gray-900 text-right">
                        $<%= parseFloat(invoice.totalAmount).toFixed(2) %>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Payment Information -->
    <% if (invoice.status === 'PAID') { %>
        <div class="mb-8 p-4 bg-green-50 rounded-lg border border-green-200">
            <h3 class="text-sm font-semibold text-green-900 mb-2">Payment Received</h3>
            <div class="text-sm text-green-800">
                <p>Paid on: <%= new Date(invoice.paidDate).toLocaleDateString() %></p>
                <% if (invoice.paymentMethod) { %>
                    <p>Payment Method: <%= invoice.paymentMethod %></p>
                <% } %>
                <% if (invoice.paymentTransactionId) { %>
                    <p>Transaction ID: <%= invoice.paymentTransactionId %></p>
                <% } %>
            </div>
        </div>
    <% } %>

    <!-- Footer -->
    <div class="mt-12 pt-4 border-t border-gray-300 text-center text-xs text-gray-500">
        <p>Thank you for your business!</p>
        <p class="mt-2">This is a computer-generated invoice.</p>
    </div>
</div>

