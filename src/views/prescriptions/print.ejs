<div class="max-w-3xl mx-auto p-8 bg-white">
    <!-- Header -->
    <div class="text-center mb-8 border-b-2 border-gray-300 pb-4">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">PRESCRIPTION</h1>
        <p class="text-gray-600">Medical Prescription</p>
    </div>

    <!-- Clinic/Doctor Info -->
    <div class="mb-6">
        <div class="flex justify-between">
            <div>
                <p class="font-semibold text-gray-900">Dr. <%= doctor.name %></p>
                <% if (prescription.doctorLicense) { %>
                    <p class="text-sm text-gray-600">License: <%= prescription.doctorLicense %></p>
                <% } %>
            </div>
            <div class="text-right">
                <p class="text-sm text-gray-600">Date: <%= new Date(prescription.created_at).toLocaleDateString() %></p>
            </div>
        </div>
    </div>

    <!-- Patient Info -->
    <div class="mb-6 p-4 bg-gray-50 rounded-lg">
        <h3 class="font-semibold text-gray-900 mb-2">Patient Information</h3>
        <div class="grid grid-cols-2 gap-2 text-sm">
            <div>
                <span class="text-gray-600">Name:</span>
                <span class="font-medium text-gray-900"><%= patient.name %></span>
            </div>
            <% if (patient.age) { %>
                <div>
                    <span class="text-gray-600">Age:</span>
                    <span class="font-medium text-gray-900"><%= patient.age %> years</span>
                </div>
            <% } %>
            <% if (patient.gender) { %>
                <div>
                    <span class="text-gray-600">Gender:</span>
                    <span class="font-medium text-gray-900"><%= patient.gender %></span>
                </div>
            <% } %>
            <% if (patient.phone) { %>
                <div>
                    <span class="text-gray-600">Phone:</span>
                    <span class="font-medium text-gray-900"><%= patient.phone %></span>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Medicines -->
    <div class="mb-6">
        <h3 class="font-semibold text-gray-900 mb-3 text-lg">Medicines</h3>
        <% if (Array.isArray(prescription.medicines) && prescription.medicines.length > 0) { %>
            <table class="w-full border-collapse border border-gray-300">
                <thead>
                    <tr class="bg-gray-100">
                        <th class="border border-gray-300 px-4 py-2 text-left text-sm font-semibold">S.No</th>
                        <th class="border border-gray-300 px-4 py-2 text-left text-sm font-semibold">Medicine Name</th>
                        <th class="border border-gray-300 px-4 py-2 text-left text-sm font-semibold">Dosage</th>
                        <th class="border border-gray-300 px-4 py-2 text-left text-sm font-semibold">Frequency</th>
                        <th class="border border-gray-300 px-4 py-2 text-left text-sm font-semibold">Duration</th>
                    </tr>
                </thead>
                <tbody>
                    <% prescription.medicines.forEach((medicine, index) => { %>
                        <tr>
                            <td class="border border-gray-300 px-4 py-2 text-sm"><%= index + 1 %></td>
                            <td class="border border-gray-300 px-4 py-2 text-sm font-medium">
                                <%= medicine.name || 'Medicine' %>
                                <% if (medicine.strength) { %>
                                    <span class="text-gray-600">(<%= medicine.strength %>)</span>
                                <% } %>
                            </td>
                            <td class="border border-gray-300 px-4 py-2 text-sm"><%= medicine.dosage || '-' %></td>
                            <td class="border border-gray-300 px-4 py-2 text-sm"><%= medicine.frequency || '-' %></td>
                            <td class="border border-gray-300 px-4 py-2 text-sm"><%= medicine.duration || '-' %></td>
                        </tr>
                        <% if (medicine.instructions) { %>
                            <tr>
                                <td colspan="5" class="border border-gray-300 px-4 py-2 text-xs text-gray-600">
                                    <strong>Instructions:</strong> <%= medicine.instructions %>
                                </td>
                            </tr>
                        <% } %>
                    <% }); %>
                </tbody>
            </table>
        <% } else { %>
            <p class="text-gray-500">No medicines prescribed</p>
        <% } %>
    </div>

    <!-- Advice -->
    <% if (prescription.advice) { %>
        <div class="mb-6">
            <h3 class="font-semibold text-gray-900 mb-2 text-lg">Advice</h3>
            <p class="text-gray-700"><%= prescription.advice %></p>
        </div>
    <% } %>

    <!-- Signature -->
    <div class="mt-12 flex justify-between items-end">
        <div>
            <% if (prescription.doctorSignature) { %>
                <img src="<%= prescription.doctorSignature %>" alt="Signature" class="h-16 mb-2">
            <% } %>
            <div class="border-t-2 border-gray-400 w-48 pt-2">
                <p class="font-semibold text-gray-900">Dr. <%= prescription.doctorName || doctor.name %></p>
                <% if (prescription.doctorLicense) { %>
                    <p class="text-xs text-gray-600">License: <%= prescription.doctorLicense %></p>
                <% } %>
            </div>
        </div>
        <div class="text-sm text-gray-600">
            <p>Prescription ID: <%= prescription.id.substring(0, 8) %></p>
        </div>
    </div>

    <!-- Footer -->
    <div class="mt-8 pt-4 border-t border-gray-300 text-center text-xs text-gray-500">
        <p>This is a computer-generated prescription. Please consult your doctor for any concerns.</p>
    </div>
</div>

