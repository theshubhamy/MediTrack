<div>
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Prescription History</h1>
            <p class="text-gray-600 mt-2">
                Prescription history for
                <a href="/patients/<%= patient.id %>" class="text-blue-600 hover:text-blue-700 font-semibold">
                    <%= patient.name %>
                </a>
            </p>
        </div>
        <div class="mt-4 md:mt-0">
            <a href="/patients/<%= patient.id %>"
                class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors">
                ← Back to Patient
            </a>
        </div>
    </div>

    <% if (prescriptions.length===0) { %>
        <div class="bg-white rounded-lg shadow-md p-12 text-center">
            <p class="text-gray-500 mb-4">No prescription history found for this patient</p>
        </div>
        <% } else { %>
            <div class="space-y-6">
                <% prescriptions.forEach((prescription, index)=> { %>
                    <div class="bg-white rounded-lg shadow-md p-6">
                        <div class="flex justify-between items-start mb-4">
                            <div>
                                <h3 class="text-lg font-semibold text-gray-900">
                                    Prescription #<%= prescriptions.length - index %>
                                </h3>
                                <p class="text-sm text-gray-600">
                                    <%= new Date(prescription.created_at).toLocaleDateString('en-US', { weekday: 'long'
                                        , year: 'numeric' , month: 'long' , day: 'numeric' }) %>
                                </p>
                                <p class="text-sm text-gray-600">
                                    <%= prescription.doctor.name %>
                                </p>
                            </div>
                            <div class="flex gap-2">
                                <a href="/prescriptions/<%= prescription.id %>"
                                    class="px-3 py-1 bg-blue-600 text-white text-sm rounded hover:bg-blue-700">
                                    View
                                </a>
                                <a href="/prescriptions/<%= prescription.id %>/print" target="_blank"
                                    class="px-3 py-1 bg-green-600 text-white text-sm rounded hover:bg-green-700">
                                    Print
                                </a>
                            </div>
                        </div>

                        <!-- Medicines Summary -->
                        <% if (Array.isArray(prescription.medicines) && prescription.medicines.length> 0) { %>
                            <div class="mb-4">
                                <h4 class="text-sm font-semibold text-gray-700 mb-2">Medicines (<%=
                                        prescription.medicines.length %>)</h4>
                                <div class="space-y-1">
                                    <% prescription.medicines.slice(0, 3).forEach(medicine=> { %>
                                        <p class="text-sm text-gray-600">
                                            • <%= medicine.name %>
                                                <% if (medicine.strength) { %>(<%= medicine.strength %>)<% } %>
                                                            <% if (medicine.frequency) { %> - <%= medicine.frequency %>
                                                                    <% } %>
                                        </p>
                                        <% }); %>
                                            <% if (prescription.medicines.length> 3) { %>
                                                <p class="text-sm text-gray-500">... and <%=
                                                        prescription.medicines.length - 3 %> more</p>
                                                <% } %>
                                </div>
                            </div>
                            <% } %>

                                <!-- Advice -->
                                <% if (prescription.advice) { %>
                                    <div class="mb-4">
                                        <h4 class="text-sm font-semibold text-gray-700 mb-1">Advice</h4>
                                        <p class="text-sm text-gray-600">
                                            <%= prescription.advice.substring(0, 100) %>
                                                <% if (prescription.advice.length> 100) { %>...<% } %>
                                        </p>
                                    </div>
                                    <% } %>

                                        <div class="text-xs text-gray-500">
                                            Visit: <a href="/visits/<%= prescription.visit.id %>"
                                                class="text-blue-600 hover:text-blue-700">
                                                View Visit Record
                                            </a>
                                        </div>
                    </div>
                    <% }); %>
            </div>
            <% } %>
</div>
