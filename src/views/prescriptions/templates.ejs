<div>
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Prescription Templates</h1>
            <p class="text-gray-600 mt-2">Manage reusable prescription templates</p>
        </div>
        <div class="mt-4 md:mt-0">
            <a href="/prescriptions/templates/new" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                ➕ New Template
            </a>
        </div>
    </div>

    <% if (templates.length === 0) { %>
        <div class="bg-white rounded-lg shadow-md p-12 text-center">
            <p class="text-gray-500 mb-4">No templates created yet</p>
            <a href="/prescriptions/templates/new" class="text-blue-600 hover:text-blue-700">Create your first template</a>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% templates.forEach(template => { %>
                <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900">
                                <%= template.name %>
                                <% if (template.isDefault) { %>
                                    <span class="ml-2 px-2 py-1 text-xs bg-blue-100 text-blue-800 rounded">Default</span>
                                <% } %>
                            </h3>
                            <% if (template.description) { %>
                                <p class="text-sm text-gray-600 mt-1"><%= template.description %></p>
                            <% } %>
                        </div>
                    </div>

                    <div class="mb-4">
                        <p class="text-sm text-gray-600">
                            <span class="font-medium"><%= Array.isArray(template.medicines) ? template.medicines.length : 0 %></span> medicines
                        </p>
                    </div>

                    <div class="flex gap-2">
                        <a href="/prescriptions/templates/<%= template.id %>/edit"
                            class="flex-1 text-center px-3 py-2 bg-blue-600 text-white text-sm rounded hover:bg-blue-700">
                            Edit
                        </a>
                        <button onclick="useTemplate('<%= template.id %>')"
                            class="flex-1 px-3 py-2 bg-green-600 text-white text-sm rounded hover:bg-green-700">
                            Use
                        </button>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>

<script>
function useTemplate(templateId) {
    // This would typically redirect to a visit/prescription creation page with template pre-filled
    window.location.href = `/visits/new?templateId=${templateId}`;
}
</script>

