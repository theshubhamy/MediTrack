<div>
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-900">
            <%= template ? 'Edit' : 'New' %> Prescription Template
        </h1>
        <p class="text-gray-600 mt-2">Create a reusable prescription template</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
            <%= error %>
        </div>
    <% } %>

    <form method="POST" action="<%= template ? `/prescriptions/templates/${template.id}` : '/prescriptions/templates' %>" id="template-form" class="space-y-6">
        <!-- Template Info -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
                        Template Name <span class="text-red-500">*</span>
                    </label>
                    <input type="text" name="name" id="name" required
                        value="<%= template ? template.name : '' %>"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                        placeholder="e.g., Common Cold, Fever, etc.">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        <input type="checkbox" name="isDefault" value="true"
                            <%= template && template.isDefault ? 'checked' : '' %>
                            class="mr-2">
                        Set as Default Template
                    </label>
                </div>
            </div>
            <div class="mt-4">
                <label for="description" class="block text-sm font-medium text-gray-700 mb-2">
                    Description (Optional)
                </label>
                <textarea name="description" id="description" rows="2"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    placeholder="Brief description of when to use this template..."><%= template ? template.description || '' : '' %></textarea>
            </div>
        </div>

        <!-- Medicines Section -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-semibold text-gray-900">Medicines</h2>
                <button type="button" id="addMedicineBtn" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
                    + Add Medicine
                </button>
            </div>

            <div id="medicinesList" class="space-y-4">
                <!-- Medicines will be added here dynamically -->
            </div>

            <input type="hidden" name="medicines" id="medicinesInput" value="<%= template ? JSON.stringify(template.medicines || []) : '[]' %>">
        </div>

        <!-- Advice Section -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <label for="advice" class="block text-sm font-medium text-gray-700 mb-2">
                Default Advice / Instructions
            </label>
            <textarea name="advice" id="advice" rows="4"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                placeholder="Default advice to include with this template..."><%= template ? template.advice || '' : '' %></textarea>
        </div>

        <!-- Actions -->
        <div class="flex gap-4">
            <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                <%= template ? 'Update' : 'Create' %> Template
            </button>
            <a href="/prescriptions/templates" class="px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors">
                Cancel
            </a>
            <% if (template) { %>
                <form method="POST" action="/prescriptions/templates/<%= template.id %>/delete" class="inline" onsubmit="return confirm('Are you sure you want to delete this template?');">
                    <button type="submit" class="px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">
                        Delete
                    </button>
                </form>
            <% } %>
        </div>
    </form>
</div>

<!-- Medicine Item Template (hidden) -->
<template id="medicineTemplate">
    <div class="medicine-item border border-gray-200 rounded-lg p-4 bg-gray-50">
        <div class="flex justify-between items-start mb-3">
            <h3 class="text-lg font-semibold text-gray-900">Medicine <span class="medicine-index"></span></h3>
            <button type="button" class="remove-medicine-btn text-red-600 hover:text-red-700 font-medium">Remove</button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Medicine Search -->
            <div class="md:col-span-2">
                <label class="block text-sm font-medium text-gray-700 mb-2">Search Medicine</label>
                <input type="text" class="medicine-search w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    placeholder="Type to search medicines...">
                <div class="medicine-results hidden mt-2 border border-gray-200 rounded-lg bg-white max-h-48 overflow-y-auto"></div>
            </div>

            <!-- Medicine Details (hidden until medicine selected) -->
            <div class="medicine-details hidden md:col-span-2 space-y-4">
                <input type="hidden" class="medicine-id">
                <input type="hidden" class="medicine-strength">

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Medicine Name</label>
                    <input type="text" class="medicine-name w-full px-4 py-2 border border-gray-300 rounded-lg" readonly>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Default Dosage</label>
                        <input type="text" class="medicine-dosage w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                            placeholder="e.g., 500mg">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Default Frequency</label>
                        <select class="medicine-frequency w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                            <option value="">Select...</option>
                            <option value="Once daily">Once daily</option>
                            <option value="Twice daily">Twice daily</option>
                            <option value="Thrice daily">Thrice daily</option>
                            <option value="Four times daily">Four times daily</option>
                            <option value="Every 6 hours">Every 6 hours</option>
                            <option value="Every 8 hours">Every 8 hours</option>
                            <option value="Every 12 hours">Every 12 hours</option>
                            <option value="As needed">As needed</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Default Duration</label>
                        <input type="text" class="medicine-duration w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                            placeholder="e.g., 7 days">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Default Quantity</label>
                        <input type="text" class="medicine-quantity w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                            placeholder="e.g., 30 tablets">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Default Instructions</label>
                    <textarea class="medicine-instructions w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" rows="2"
                        placeholder="Default instructions for this medicine..."></textarea>
                </div>
            </div>
        </div>
    </div>
</template>

<script src="/js/prescription-form.js"></script>
<script>
// Initialize with existing medicines if editing
document.addEventListener('DOMContentLoaded', function() {
    <% if (template && template.medicines && template.medicines.length > 0) { %>
        const existingMedicines = <%= JSON.stringify(template.medicines) %>;
        setTimeout(() => {
            existingMedicines.forEach(medicine => {
                if (window.addMedicineFromData) {
                    window.addMedicineFromData(medicine);
                } else {
                    // Fallback: trigger add button and populate
                    document.getElementById('addMedicineBtn')?.click();
                    setTimeout(() => {
                        const lastItem = document.querySelectorAll('.medicine-item').slice(-1)[0];
                        if (lastItem) {
                            populateMedicineFields(lastItem, medicine);
                        }
                    }, 100);
                }
            });
        }, 500);
    <% } %>
});
</script>

