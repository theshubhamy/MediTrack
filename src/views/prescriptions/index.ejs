<div>
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Prescriptions</h1>
    <p class="text-gray-600 mt-2">View and manage all prescriptions</p>
  </div>

  <!-- Filters -->
  <div class="bg-white rounded-lg shadow-md p-6 mb-6">
    <form method="GET" class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Patient</label>
        <input type="text" name="patientId" value="<%= filters.patientId || '' %>" placeholder="Patient ID"
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
      </div>
      <% if (canViewAll) { %>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Doctor</label>
          <input type="text" name="doctorId" value="<%= filters.doctorId || '' %>" placeholder="Doctor ID"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
        </div>
        <% } %>
          <div class="flex items-end">
            <button type="submit"
              class="w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
              Filter
            </button>
          </div>
    </form>
  </div>

  <!-- Prescriptions List -->
  <div class="bg-white rounded-lg shadow-md overflow-hidden">
    <% if (prescriptions.length===0) { %>
      <div class="text-center py-12">
        <p class="text-gray-500 mb-4">No prescriptions found</p>
      </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Patient</th>
                <% if (canViewAll) { %>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Doctor</th>
                  <% } %>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Medicines
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions
                    </th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% prescriptions.forEach(prescription=> { %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    <%= new Date(prescription.visit.created_at).toLocaleDateString() %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <a href="/patients/<%= prescription.patient.id %>"
                      class="text-sm font-medium text-blue-600 hover:text-blue-700">
                      <%= prescription.patient.name %>
                    </a>
                  </td>
                  <% if (canViewAll) { %>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                      <%= prescription.doctor.name %>
                    </td>
                    <% } %>
                      <td class="px-6 py-4 text-sm text-gray-500">
                        <%= Array.isArray(prescription.medicines) ? prescription.medicines.length : 0 %> medicine(s)
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm">
                        <a href="/prescriptions/<%= prescription.id %>"
                          class="text-blue-600 hover:text-blue-700 mr-3">View</a>
                        <a href="/prescriptions/<%= prescription.id %>/print" target="_blank"
                          class="text-green-600 hover:text-green-700">Print</a>
                      </td>
                </tr>
                <% }); %>
            </tbody>
          </table>
        </div>
        <% } %>
  </div>
</div>
