<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Print' %></title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        @media print {
            body { margin: 0; padding: 20px; }
            .no-print { display: none; }
            .print-break { page-break-after: always; }
        }
        @page {
            size: A4;
            margin: 20mm;
        }
    </style>
</head>
<body class="bg-white">
    <div class="no-print mb-4">
        <button onclick="window.print()" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
            🖨️ Print
        </button>
        <button onclick="window.close()" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 ml-2">
            Close
        </button>
    </div>
    <%- body %>
    <script>
        // Auto-print on load (optional)
        // window.onload = function() { window.print(); }
    </script>
</body>
</html>

