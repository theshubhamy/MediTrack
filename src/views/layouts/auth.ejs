<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>
            <%= typeof title !=='undefined' ? title + ' - MediTrack' : 'MediTrack' %>
        </title>
        <link rel="stylesheet" href="/css/style.css">
    </head>

    <body
        class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-500 via-blue-600 to-purple-700">
