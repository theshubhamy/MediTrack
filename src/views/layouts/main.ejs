<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' - MediTrack' : 'MediTrack' %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex-shrink-0">
                    <a href="/dashboard" class="text-2xl font-bold text-blue-600 hover:text-blue-700">🏥 MediTrack</a>
                </div>
                <% if (typeof user !== 'undefined' && user) { %>
                <div class="flex items-center space-x-6">
                    <a href="/dashboard" class="text-gray-700 hover:text-blue-600 transition-colors">Dashboard</a>
                    <a href="/patients" class="text-gray-700 hover:text-blue-600 transition-colors">Patients</a>
                    <% if (user.role === 'CLINIC_ADMIN' || user.role === 'STAFF') { %>
                    <a href="/doctors" class="text-gray-700 hover:text-blue-600 transition-colors">Doctors</a>
                    <% } %>
                    <% if (user.role === 'CLINIC_ADMIN') { %>
                    <a href="/settings" class="text-gray-700 hover:text-blue-600 transition-colors">Settings</a>
                    <% } %>
                    <div class="flex items-center space-x-3">
                        <span class="text-sm text-gray-500">
                            <%= user.name %>
                            <span class="ml-2 px-2 py-1 text-xs bg-blue-100 text-blue-800 rounded-full">
                                <%= user.role.replace('_', ' ') %>
                            </span>
                        </span>
                        <a href="/logout" class="btn btn-sm bg-red-600 hover:bg-red-700 text-white">Logout</a>
                    </div>
                </div>
                <% } %>
            </div>
        </div>
    </nav>

    <main class="flex-1 py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <%- body %>
        </div>
    </main>

    <footer class="bg-white border-t border-gray-200 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <p class="text-center text-gray-500 text-sm">&copy; <%= new Date().getFullYear() %> MediTrack. All rights reserved.</p>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>

