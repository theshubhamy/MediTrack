<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' - MediTrack Admin' : 'MediTrack Admin' %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">
    <nav class="bg-purple-600 border-b border-purple-700 sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex-shrink-0">
                    <a href="/admin" class="text-2xl font-bold text-white hover:text-purple-100">🏥 MediTrack Admin</a>
                </div>
                <% if (typeof admin !== 'undefined' && admin) { %>
                <div class="flex items-center space-x-6">
                    <a href="/admin" class="text-purple-100 hover:text-white transition-colors">Dashboard</a>
                    <a href="/admin/clinics" class="text-purple-100 hover:text-white transition-colors">Clinics</a>
                    <div class="flex items-center space-x-3">
                        <span class="text-sm text-purple-100">
                            <%= admin.name %>
                            <span class="ml-2 px-2 py-1 text-xs bg-purple-700 text-white rounded-full">
                                ADMIN
                            </span>
                        </span>
                        <a href="/admin/logout" class="btn btn-sm bg-red-600 hover:bg-red-700 text-white">Logout</a>
                    </div>
                </div>
                <% } %>
            </div>
        </div>
    </nav>

    <main class="flex-1 py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <%- body %>
        </div>
    </main>

    <footer class="bg-white border-t border-gray-200 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <p class="text-center text-gray-500 text-sm">&copy; <%= new Date().getFullYear() %> MediTrack Admin. All rights reserved.</p>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>

