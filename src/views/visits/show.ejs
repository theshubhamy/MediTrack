<div>
    <div class="page-header">
        <h1 class="text-3xl font-bold text-gray-900">Visit Details</h1>
        <a href="/patients/<%= visit.patient.id %>" class="btn btn-secondary">Back to Patient</a>
    </div>

    <div class="space-y-6">
        <div class="card">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Visit Information</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="text-sm font-medium text-gray-500">Date</label>
                    <p class="mt-1 text-gray-900">
                        <%= new Date(visit.created_at).toLocaleString() %>
                    </p>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-500">Patient</label>
                    <p class="mt-1">
                        <a href="/patients/<%= visit.patient.id %>" class="text-blue-600 hover:text-blue-700">
                            <%= visit.patient.name %>
                        </a>
                    </p>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-500">Doctor</label>
                    <p class="mt-1 text-gray-900">
                        <%= visit.doctor.name %>
                    </p>
                </div>
                <% if (visit.nextVisitDate) { %>
                    <div>
                        <label class="text-sm font-medium text-gray-500">Next Visit</label>
                        <p class="mt-1 text-gray-900">
                            <%= new Date(visit.nextVisitDate).toLocaleDateString() %>
                        </p>
                    </div>
                    <% } %>
            </div>
        </div>

        <% if (visit.symptoms) { %>
            <div class="card">
                <h3 class="text-lg font-semibold text-gray-900 mb-3">Symptoms</h3>
                <p class="text-gray-700 whitespace-pre-wrap">
                    <%= visit.symptoms %>
                </p>
            </div>
            <% } %>

                <% if (visit.diagnosis) { %>
                    <div class="card">
                        <h3 class="text-lg font-semibold text-gray-900 mb-3">Diagnosis</h3>
                        <p class="text-gray-700 whitespace-pre-wrap">
                            <%= visit.diagnosis %>
                        </p>
                    </div>
                    <% } %>

                        <% if (visit.notes) { %>
                            <div class="card">
                                <h3 class="text-lg font-semibold text-gray-900 mb-3">Notes</h3>
                                <p class="text-gray-700 whitespace-pre-wrap">
                                    <%= visit.notes %>
                                </p>
                            </div>
                            <% } %>

                                <!-- Prescription Section -->
                                <div class="card">
                                    <div class="flex justify-between items-center mb-4">
                                        <h3 class="text-lg font-semibold text-gray-900">Prescription</h3>
                                        <% if (canEdit) { %>
                                            <% if (visit.prescription) { %>
                                                <div class="flex gap-2">
                                                    <a href="/prescriptions/<%= visit.prescription.id %>/edit"
                                                        class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-sm">
                                                        Edit Prescription
                                                    </a>
                                                    <a href="/prescriptions/<%= visit.prescription.id %>"
                                                        class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors text-sm">
                                                        View Details
                                                    </a>
                                                    <a href="/prescriptions/<%= visit.prescription.id %>/print"
                                                        class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors text-sm"
                                                        target="_blank">
                                                        Print
                                                    </a>
                                                </div>
                                                <% } else { %>
                                                    <a href="/prescriptions/new/<%= visit.id %>"
                                                        class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-sm">
                                                        Create Prescription
                                                    </a>
                                                    <% } %>
                                                        <% } %>
                                    </div>

                                    <% if (visit.prescription) { %>
                                        <div class="space-y-4">
                                            <!-- Medicines -->
                                            <% if (Array.isArray(visit.prescription.medicines) &&
                                                visit.prescription.medicines.length> 0) { %>
                                                <div>
                                                    <h4 class="text-sm font-medium text-gray-700 mb-2">Medicines</h4>
                                                    <div class="space-y-2">
                                                        <% visit.prescription.medicines.forEach((medicine, index)=> { %>
                                                            <div
                                                                class="bg-gray-50 rounded-lg p-3 border border-gray-200">
                                                                <div class="flex justify-between items-start">
                                                                    <div class="flex-1">
                                                                        <p class="font-medium text-gray-900">
                                                                            <%= index + 1 %>. <%= medicine.name
                                                                                    || 'Medicine' %>
                                                                                    <% if (medicine.strength) { %>
                                                                                        <span class="text-gray-600">(<%=
                                                                                                medicine.strength %>
                                                                                                )</span>
                                                                                        <% } %>
                                                                        </p>
                                                                        <div
                                                                            class="mt-1 grid grid-cols-2 gap-2 text-sm text-gray-600">
                                                                            <% if (medicine.dosage) { %>
                                                                                <span><strong>Dosage:</strong>
                                                                                    <%= medicine.dosage %>
                                                                                </span>
                                                                                <% } %>
                                                                                    <% if (medicine.frequency) { %>
                                                                                        <span><strong>Frequency:</strong>
                                                                                            <%= medicine.frequency %>
                                                                                        </span>
                                                                                        <% } %>
                                                                                            <% if (medicine.duration) {
                                                                                                %>
                                                                                                <span><strong>Duration:</strong>
                                                                                                    <%= medicine.duration
                                                                                                        %>
                                                                                                </span>
                                                                                                <% } %>
                                                                                                    <% if
                                                                                                        (medicine.quantity)
                                                                                                        { %>
                                                                                                        <span><strong>Quantity:</strong>
                                                                                                            <%= medicine.quantity
                                                                                                                %>
                                                                                                        </span>
                                                                                                        <% } %>
                                                                        </div>
                                                                        <% if (medicine.instructions) { %>
                                                                            <p class="mt-1 text-sm text-gray-600">
                                                                                <strong>Instructions:</strong>
                                                                                <%= medicine.instructions %>
                                                                            </p>
                                                                            <% } %>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <% }); %>
                                                    </div>
                                                </div>
                                                <% } %>

                                                    <!-- Advice -->
                                                    <% if (visit.prescription.advice) { %>
                                                        <div>
                                                            <h4 class="text-sm font-medium text-gray-700 mb-2">Advice
                                                            </h4>
                                                            <p class="text-gray-700 whitespace-pre-wrap">
                                                                <%= visit.prescription.advice %>
                                                            </p>
                                                        </div>
                                                        <% } %>

                                                            <!-- Signature -->
                                                            <% if (visit.prescription.doctorSignature) { %>
                                                                <div>
                                                                    <h4 class="text-sm font-medium text-gray-700 mb-2">
                                                                        Doctor Signature</h4>
                                                                    <img src="<%= visit.prescription.doctorSignature %>"
                                                                        alt="Signature"
                                                                        class="max-w-xs border border-gray-200 rounded">
                                                                    <% if (visit.prescription.doctorName) { %>
                                                                        <p class="text-sm text-gray-600 mt-1">Dr. <%=
                                                                                visit.prescription.doctorName %>
                                                                        </p>
                                                                        <% } %>
                                                                </div>
                                                                <% } %>
                                        </div>
                                        <% } else { %>
                                            <p class="text-gray-500">No prescription created yet.</p>
                                            <% } %>
                                </div>
    </div>
</div>
