<div>
    <h1 class="text-3xl font-bold text-gray-900 mb-8">Invite Doctor</h1>

    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error">
        <%= error %>
    </div>
    <% } %>

    <div class="card max-w-2xl">
        <form method="POST" action="/doctors/invite" class="space-y-6">
            <div class="form-group">
                <label for="name" class="form-label">Name *</label>
                <input type="text" id="name" name="name" required class="form-input" value="<%= typeof name !== 'undefined' ? name : '' %>">
            </div>

            <div class="form-group">
                <label for="email" class="form-label">Email *</label>
                <input type="email" id="email" name="email" required class="form-input" value="<%= typeof email !== 'undefined' ? email : '' %>">
            </div>

            <div class="form-group">
                <label for="phone" class="form-label">Phone</label>
                <input type="tel" id="phone" name="phone" class="form-input" value="<%= typeof phone !== 'undefined' ? phone : '' %>">
            </div>

            <div class="form-actions">
                <a href="/doctors" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Send Invitation</button>
            </div>
        </form>
    </div>
</div>

