<div>
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Manage Clinics</h1>
            <p class="text-gray-600 mt-2">View and manage all clinics in the system</p>
        </div>
        <div class="flex gap-2">
            <a href="/admin/export/clinics" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
                📥 Export CSV
            </a>
            <a href="/admin" class="btn btn-secondary">Back to Dashboard</a>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-6">
        <form method="GET" action="/admin/clinics" id="clinics-filter-form" class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Search</label>
                <input type="text" name="search" value="<%= typeof filters !== 'undefined' && filters.search ? filters.search : '' %>"
                       placeholder="Name or email..."
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Plan</label>
                <select name="plan" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
                    <option value="">All Plans</option>
                    <option value="FREE" <%= typeof filters !== 'undefined' && filters.plan === 'FREE' ? 'selected' : '' %>>Free</option>
                    <option value="STARTER" <%= typeof filters !== 'undefined' && filters.plan === 'STARTER' ? 'selected' : '' %>>Starter</option>
                    <option value="CLINIC" <%= typeof filters !== 'undefined' && filters.plan === 'CLINIC' ? 'selected' : '' %>>Clinic</option>
                    <option value="PRO" <%= typeof filters !== 'undefined' && filters.plan === 'PRO' ? 'selected' : '' %>>Pro</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                <select name="status" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
                    <option value="">All Status</option>
                    <option value="ACTIVE" <%= typeof filters !== 'undefined' && filters.status === 'ACTIVE' ? 'selected' : '' %>>Active</option>
                    <option value="INACTIVE" <%= typeof filters !== 'undefined' && filters.status === 'INACTIVE' ? 'selected' : '' %>>Inactive</option>
                    <option value="SUSPENDED" <%= typeof filters !== 'undefined' && filters.status === 'SUSPENDED' ? 'selected' : '' %>>Suspended</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Created From</label>
                <input type="date" name="startDate" value="<%= typeof filters !== 'undefined' && filters.startDate ? filters.startDate : '' %>"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Created To</label>
                <input type="date" name="endDate" value="<%= typeof filters !== 'undefined' && filters.endDate ? filters.endDate : '' %>"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Sort By</label>
                <select name="sortBy" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
                    <option value="created_at" <%= typeof filters !== 'undefined' && filters.sortBy === 'created_at' ? 'selected' : '' %>>Created Date</option>
                    <option value="name" <%= typeof filters !== 'undefined' && filters.sortBy === 'name' ? 'selected' : '' %>>Name</option>
                    <option value="plan" <%= typeof filters !== 'undefined' && filters.sortBy === 'plan' ? 'selected' : '' %>>Plan</option>
                </select>
            </div>
            <div class="lg:col-span-6 flex gap-2">
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                    Filter
                </button>
                <button type="button" onclick="exportWithFilters()" class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
                    📥 Export Filtered
                </button>
                <a href="/admin/clinics" class="px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors">
                    Clear
                </a>
            </div>
        </form>
    </div>

    <!-- Statistics -->
    <% if (typeof clinicsByPlan !== 'undefined' || typeof clinicsByStatus !== 'undefined') { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <% if (typeof clinicsByPlan !== 'undefined' && clinicsByPlan.length > 0) { %>
                <%
                    const totalByPlan = clinicsByPlan.reduce((sum, item) => sum + parseInt(item.count), 0);
                %>
                <div class="card">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Clinics by Plan</h3>
                    <div class="space-y-3">
                        <% clinicsByPlan.forEach(item => { %>
                            <div>
                                <div class="flex justify-between mb-1">
                                    <span class="text-sm text-gray-700"><%= item.plan %></span>
                                    <span class="text-sm font-bold text-gray-900"><%= item.count %></span>
                                </div>
                                <div class="w-full bg-gray-200 rounded-full h-2">
                                    <div class="bg-blue-600 h-2 rounded-full" style="--bar-width: <%= totalByPlan > 0 ? (parseInt(item.count) / totalByPlan) * 100 : 0 %>%; width: var(--bar-width);"></div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% } %>
            <% if (typeof clinicsByStatus !== 'undefined' && clinicsByStatus.length > 0) { %>
                <%
                    const totalByStatus = clinicsByStatus.reduce((sum, item) => sum + parseInt(item.count), 0);
                %>
                <div class="card">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Clinics by Status</h3>
                    <div class="space-y-3">
                        <% clinicsByStatus.forEach(item => { %>
                            <div>
                                <div class="flex justify-between mb-1">
                                    <span class="text-sm text-gray-700"><%= item.subscriptionStatus %></span>
                                    <span class="text-sm font-bold text-gray-900"><%= item.count %></span>
                                </div>
                                <div class="w-full bg-gray-200 rounded-full h-2">
                                    <div class="bg-green-600 h-2 rounded-full" style="--bar-width: <%= totalByStatus > 0 ? (parseInt(item.count) / totalByStatus) * 100 : 0 %>%; width: var(--bar-width);"></div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% } %>
        </div>
    <% } %>

    <!-- Clinics Table -->
    <div class="card">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold text-gray-900">Clinics (<%= typeof pagination !== 'undefined' ? pagination.total : clinics.length %>)</h2>
        </div>
        <% if (clinics.length === 0) { %>
            <div class="empty-state">
                <p>No clinics found.</p>
            </div>
        <% } else { %>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Plan</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Users</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% clinics.forEach(clinic => { %>
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                    <%= clinic.name %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    <%= clinic.email || '-' %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <span class="px-2 py-1 text-xs rounded-full bg-blue-100 text-blue-800">
                                        <%= clinic.plan %>
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <span class="px-2 py-1 text-xs rounded-full <%= clinic.subscriptionStatus === 'ACTIVE' ? 'bg-green-100 text-green-800' : clinic.subscriptionStatus === 'SUSPENDED' ? 'bg-red-100 text-red-800' : 'bg-gray-100 text-gray-800' %>">
                                        <%= clinic.subscriptionStatus %>
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <%= clinic.users && clinic.users.length > 0 ? clinic.users.length + ' user' + (clinic.users.length > 1 ? 's' : '') : '0 users' %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <%= new Date(clinic.created_at).toLocaleDateString() %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <a href="/admin/clinics/<%= clinic.id %>" class="btn btn-sm">View Details</a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <% if (typeof pagination !== 'undefined' && pagination.pages > 1) { %>
                <div class="mt-6 flex items-center justify-between">
                    <div class="text-sm text-gray-700">
                        Showing <%= (pagination.page - 1) * pagination.limit + 1 %> to <%= Math.min(pagination.page * pagination.limit, pagination.total) %> of <%= pagination.total %> clinics
                    </div>
                    <div class="flex gap-2">
                        <% if (typeof pagination !== 'undefined' && pagination.page > 1) { %>
                            <a href="?page=<%= pagination.page - 1 %><%= typeof filters !== 'undefined' && filters.search ? '&search=' + filters.search : '' %><%= typeof filters !== 'undefined' && filters.plan ? '&plan=' + filters.plan : '' %><%= typeof filters !== 'undefined' && filters.status ? '&status=' + filters.status : '' %>"
                               class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors">
                                Previous
                            </a>
                        <% } %>
                        <% if (typeof pagination !== 'undefined' && pagination.page < pagination.pages) { %>
                            <a href="?page=<%= pagination.page + 1 %><%= typeof filters !== 'undefined' && filters.search ? '&search=' + filters.search : '' %><%= typeof filters !== 'undefined' && filters.plan ? '&plan=' + filters.plan : '' %><%= typeof filters !== 'undefined' && filters.status ? '&status=' + filters.status : '' %>"
                               class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors">
                                Next
                            </a>
                        <% } %>
                    </div>
                </div>
            <% } %>
        <% } %>
    </div>
</div>

<script>
    function exportWithFilters() {
        const form = document.getElementById('clinics-filter-form');
        const formData = new FormData(form);
        const params = new URLSearchParams();

        // Add all filter parameters
        for (const [key, value] of formData.entries()) {
            if (value && key !== 'sortBy') params.append(key, value);
        }

        // Redirect to export with filters
        window.location.href = `/admin/export/clinics?${params.toString()}`;
    }
</script>
