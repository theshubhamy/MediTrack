<div>
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Financial & Subscription Management</h1>
            <p class="text-gray-600 mt-2">Track revenue, subscriptions, and billing</p>
        </div>
        <div class="flex gap-2">
            <button onclick="exportFinancialReport('revenue')" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
                📥 Export Revenue
            </button>
            <button onclick="exportFinancialReport('subscriptions')" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                📥 Export Subscriptions
            </button>
            <a href="/admin" class="btn btn-secondary">Back to Dashboard</a>
        </div>
    </div>

    <!-- Date Range Filter -->
    <div class="card mb-6">
        <form method="GET" action="/admin/financial" class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Start Date</label>
                <input type="date" name="startDate" value="<%= typeof filters !== 'undefined' && filters.startDate ? filters.startDate : '' %>"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">End Date</label>
                <input type="date" name="endDate" value="<%= typeof filters !== 'undefined' && filters.endDate ? filters.endDate : '' %>"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Quick Period</label>
                <select name="period" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
                    <option value="7" <%= typeof filters !== 'undefined' && filters.period === '7' ? 'selected' : '' %>>Last 7 days</option>
                    <option value="30" <%= typeof filters !== 'undefined' && filters.period === '30' ? 'selected' : '' %>>Last 30 days</option>
                    <option value="90" <%= typeof filters !== 'undefined' && filters.period === '90' ? 'selected' : '' %>>Last 90 days</option>
                    <option value="365" <%= typeof filters !== 'undefined' && filters.period === '365' ? 'selected' : '' %>>Last year</option>
                </select>
            </div>
            <div class="flex items-end">
                <button type="submit" class="w-full px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                    Apply Filters
                </button>
            </div>
        </form>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Total Revenue</p>
                    <p class="text-3xl font-bold text-gray-900 mt-2">$<%= stats.totalRevenue.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
                </div>
                <div class="text-4xl">💰</div>
            </div>
        </div>
        <div class="card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Active Subscriptions</p>
                    <p class="text-3xl font-bold text-gray-900 mt-2"><%= stats.activeSubscriptions %></p>
                </div>
                <div class="text-4xl">📊</div>
            </div>
        </div>
        <div class="card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Churn Rate</p>
                    <p class="text-3xl font-bold text-gray-900 mt-2"><%= stats.churnRate %>%</p>
                </div>
                <div class="text-4xl">📉</div>
            </div>
        </div>
        <div class="card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Pending Invoices</p>
                    <p class="text-3xl font-bold text-gray-900 mt-2"><%= stats.pendingInvoices %></p>
                </div>
                <div class="text-4xl">📄</div>
            </div>
        </div>
    </div>

    <!-- Revenue Forecast -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <div class="card">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Revenue Forecast</h2>
            <div class="space-y-4">
                <div class="flex justify-between items-center p-4 bg-blue-50 rounded-lg">
                    <span class="text-gray-700 font-medium">Next Month</span>
                    <span class="text-2xl font-bold text-blue-900">$<%= forecast.nextMonth.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                </div>
                <div class="flex justify-between items-center p-4 bg-green-50 rounded-lg">
                    <span class="text-gray-700 font-medium">Next 3 Months</span>
                    <span class="text-2xl font-bold text-green-900">$<%= forecast.next3Months.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                </div>
            </div>
        </div>

        <!-- Monthly Revenue Chart -->
        <div class="card">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Monthly Revenue</h2>
            <% if (typeof monthlyRevenue !== 'undefined' && monthlyRevenue.length > 0) { %>
                <%
                    const maxRevenue = Math.max(...monthlyRevenue.map(m => parseFloat(m.revenue || 0)));
                %>
                <div class="space-y-3">
                    <% monthlyRevenue.forEach(month => { %>
                        <%
                            const revenue = parseFloat(month.revenue || 0);
                            const height = maxRevenue > 0 ? (revenue / maxRevenue) * 100 : 0;
                        %>
                        <div>
                            <div class="flex justify-between mb-1">
                                <span class="text-sm text-gray-700">
                                    <%= new Date(month.month).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) %>
                                </span>
                                <span class="text-sm font-bold text-gray-900">$<%= revenue.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-3">
                                <div class="bg-blue-600 h-3 rounded-full transition-all"
                                     style="--bar-width: <%= height %>%; width: var(--bar-width);"></div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <p class="text-gray-500 text-center py-8">No revenue data available</p>
            <% } %>
        </div>
    </div>

    <!-- Plan Analytics -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <div class="card">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Subscription Plan Distribution</h2>
            <% if (typeof planDistribution !== 'undefined' && planDistribution.length > 0) { %>
                <%
                    const totalPlans = planDistribution.reduce((sum, p) => sum + parseInt(p.count), 0);
                %>
                <div class="space-y-3">
                    <% planDistribution.forEach(item => { %>
                        <div>
                            <div class="flex justify-between mb-1">
                                <span class="text-sm text-gray-700"><%= item.plan %></span>
                                <span class="text-sm font-bold text-gray-900"><%= item.count %></span>
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2">
                                <div class="bg-green-600 h-2 rounded-full"
                                     style="--bar-width: <%= totalPlans > 0 ? (parseInt(item.count) / totalPlans) * 100 : 0 %>%; width: var(--bar-width);"></div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>

        <div class="card">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Revenue by Plan</h2>
            <% if (typeof planRevenue !== 'undefined' && planRevenue.length > 0) { %>
                <%
                    const totalPlanRevenue = planRevenue.reduce((sum, p) => sum + parseFloat(p.revenue || 0), 0);
                %>
                <div class="space-y-3">
                    <% planRevenue.forEach(item => { %>
                        <%
                            const revenue = parseFloat(item.revenue || 0);
                        %>
                        <div>
                            <div class="flex justify-between mb-1">
                                <span class="text-sm text-gray-700"><%= item.plan %></span>
                                <span class="text-sm font-bold text-gray-900">$<%= revenue.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2">
                                <div class="bg-blue-600 h-2 rounded-full"
                                     style="--bar-width: <%= totalPlanRevenue > 0 ? (revenue / totalPlanRevenue) * 100 : 0 %>%; width: var(--bar-width);"></div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Payment Methods -->
    <% if (typeof paymentMethods !== 'undefined' && paymentMethods.length > 0) { %>
        <div class="card mb-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Payment Methods</h2>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payment Method</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Count</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total Revenue</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% paymentMethods.forEach(method => { %>
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                    <%= method.paymentMethod || 'Unknown' %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <%= method.count %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    $<%= parseFloat(method.total || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>

    <!-- Upcoming Renewals -->
    <% if (typeof upcomingRenewals !== 'undefined' && upcomingRenewals.length > 0) { %>
        <div class="card mb-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Upcoming Renewals (Next 30 Days)</h2>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Clinic</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Plan</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Due Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% upcomingRenewals.forEach(invoice => { %>
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                    <%= invoice.clinic ? invoice.clinic.name : '-' %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <span class="px-2 py-1 text-xs rounded-full bg-blue-100 text-blue-800">
                                        <%= invoice.plan %>
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <%= invoice.dueDate ? new Date(invoice.dueDate).toLocaleDateString() : '-' %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    $<%= parseFloat(invoice.totalAmount || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <a href="/admin/clinics/<%= invoice.clinic ? invoice.clinic.id : '' %>" class="text-blue-600 hover:text-blue-700">View Clinic</a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>

    <!-- Recent Payments -->
    <div class="card mb-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Recent Payments</h2>
        <% if (typeof recentPayments !== 'undefined' && recentPayments.length > 0) { %>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Invoice #</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Clinic</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Plan</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payment Method</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% recentPayments.forEach(payment => { %>
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                    <%= payment.invoiceNumber %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <%= payment.paid_date ? new Date(payment.paid_date).toLocaleDateString() : new Date(payment.created_at).toLocaleDateString() %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    <%= payment.clinic ? payment.clinic.name : '-' %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <span class="px-2 py-1 text-xs rounded-full bg-blue-100 text-blue-800">
                                        <%= payment.plan %>
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900">
                                    $<%= parseFloat(payment.totalAmount || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <%= payment.paymentMethod || '-' %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="text-center py-8">
                <p class="text-gray-500">No payment history available</p>
            </div>
        <% } %>
    </div>

    <!-- Subscription Changes -->
    <% if (typeof planChanges !== 'undefined' && planChanges.length > 0) { %>
        <div class="card">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Subscription Changes</h2>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Clinic</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% planChanges.forEach(change => { %>
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <%= new Date(change.created_at).toLocaleString() %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                    <%= change.clinic ? change.clinic.name : '-' %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <span class="px-2 py-1 text-xs rounded-full bg-blue-100 text-blue-800">
                                        <%= change.action %>
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-700">
                                    <%= change.description || '-' %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>
</div>

<script>
    function exportFinancialReport(type) {
        const form = document.querySelector('form');
        const formData = new FormData(form);
        const params = new URLSearchParams();

        // Add all filter parameters
        for (const [key, value] of formData.entries()) {
            if (value) params.append(key, value);
        }
        params.append('type', type);

        // Redirect to export
        window.location.href = `/admin/financial/export?${params.toString()}`;
    }
</script>

