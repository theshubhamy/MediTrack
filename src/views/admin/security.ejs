<div>
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Security Dashboard</h1>
            <p class="text-gray-600 mt-2">Monitor security events and threats</p>
        </div>
        <a href="/admin" class="btn btn-secondary">Back to Dashboard</a>
    </div>

    <!-- Security Overview -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="card">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-semibold text-gray-900">Failed Logins</h3>
                    <p class="text-3xl font-bold text-gray-900 mt-2"><%= failedLogins.length %></p>
                    <p class="text-sm text-gray-600 mt-1">Last 50 attempts</p>
                </div>
                <div class="text-4xl">🔒</div>
            </div>
        </div>
        <div class="card">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-semibold text-gray-900">Suspicious IPs</h3>
                    <p class="text-3xl font-bold text-gray-900 mt-2"><%= suspiciousIPs.length %></p>
                    <p class="text-sm text-gray-600 mt-1">Last 24 hours</p>
                </div>
                <div class="text-4xl">⚠️</div>
            </div>
        </div>
        <div class="card">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-semibold text-gray-900">Inactive Users</h3>
                    <p class="text-3xl font-bold text-gray-900 mt-2"><%= inactiveUsers %></p>
                    <p class="text-sm text-gray-600 mt-1">Suspended/Inactive</p>
                </div>
                <div class="text-4xl">👤</div>
            </div>
        </div>
    </div>

    <!-- Suspicious IPs -->
    <% if (suspiciousIPs && suspiciousIPs.length > 0) { %>
        <div class="card mb-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Suspicious IP Addresses</h2>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">IP Address</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Failed Attempts</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Attempt</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% suspiciousIPs.forEach(ip => { %>
                            <tr class="hover:bg-red-50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                    <%= ip.ip_address %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-red-600 font-bold">
                                    <%= ip.attempt_count %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <%= new Date(ip.last_attempt).toLocaleString() %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>

    <!-- Failed Login Attempts -->
    <div class="card mb-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Recent Failed Login Attempts</h2>
        <% if (failedLogins.length === 0) { %>
            <div class="text-center py-8">
                <div class="text-4xl mb-2">✅</div>
                <p class="text-gray-600">No failed login attempts found</p>
            </div>
        <% } else { %>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Timestamp</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User/Email</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Clinic</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">IP Address</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% failedLogins.forEach(log => { %>
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <%= new Date(log.created_at).toLocaleString() %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    <%= log.user ? `${log.user.name} (${log.user.email})` : log.description || 'Unknown' %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <%= log.clinic ? log.clinic.name : '-' %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <%= log.ipAddress || '-' %>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-700">
                                    <%= log.description || '-' %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <!-- Recent Security Events -->
    <div class="card">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Recent Security Events</h2>
        <% if (recentSecurityEvents.length === 0) { %>
            <div class="text-center py-8">
                <div class="text-4xl mb-2">✅</div>
                <p class="text-gray-600">No recent security events</p>
            </div>
        <% } else { %>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Timestamp</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User/Clinic</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% recentSecurityEvents.forEach(event => { %>
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <%= new Date(event.created_at).toLocaleString() %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <span class="px-2 py-1 text-xs rounded-full bg-blue-100 text-blue-800">
                                        <%= event.action %>
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    <%= event.user ? event.user.name : event.clinic ? event.clinic.name : 'System' %>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-700">
                                    <%= event.description || '-' %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

