<div>
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-900">Admin Dashboard</h1>
        <p class="text-gray-600 mt-2">System-wide statistics and management</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-8">
        <div class="stat-card">
            <div class="text-4xl">🏥</div>
            <div>
                <h3 class="text-3xl font-bold text-gray-900"><%= stats.totalClinics %></h3>
                <p class="text-gray-600 text-sm">Total Clinics</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="text-4xl">✅</div>
            <div>
                <h3 class="text-3xl font-bold text-gray-900"><%= stats.activeClinics %></h3>
                <p class="text-gray-600 text-sm">Active Clinics</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="text-4xl">👥</div>
            <div>
                <h3 class="text-3xl font-bold text-gray-900"><%= stats.totalUsers %></h3>
                <p class="text-gray-600 text-sm">Total Users</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="text-4xl">📋</div>
            <div>
                <h3 class="text-3xl font-bold text-gray-900"><%= stats.totalPatients %></h3>
                <p class="text-gray-600 text-sm">Total Patients</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="text-4xl">📊</div>
            <div>
                <h3 class="text-3xl font-bold text-gray-900"><%= stats.totalVisits %></h3>
                <p class="text-gray-600 text-sm">Total Visits</p>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="card">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Recent Clinics</h2>
            <% if (recentClinics.length === 0) { %>
            <div class="empty-state">
                <p>No clinics found.</p>
            </div>
            <% } else { %>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Plan</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% recentClinics.forEach(clinic => { %>
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= clinic.name %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                <span class="px-2 py-1 text-xs rounded-full bg-blue-100 text-blue-800"><%= clinic.plan %></span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                <span class="px-2 py-1 text-xs rounded-full <%= clinic.subscriptionStatus === 'ACTIVE' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                                    <%= clinic.subscriptionStatus %>
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= new Date(clinic.createdAt).toLocaleDateString() %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                <a href="/admin/clinics/<%= clinic.id %>" class="btn btn-sm">View</a>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <% } %>
        </div>

        <div class="card">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Clinics by Plan</h2>
            <% if (clinicsByPlan.length === 0) { %>
            <div class="empty-state">
                <p>No data available.</p>
            </div>
            <% } else { %>
            <div class="space-y-4">
                <% clinicsByPlan.forEach(item => { %>
                <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                    <span class="text-sm font-medium text-gray-700"><%= item.plan %></span>
                    <span class="text-2xl font-bold text-gray-900"><%= item.count %></span>
                </div>
                <% }); %>
            </div>
            <% } %>
        </div>
    </div>

    <div class="mt-6">
        <a href="/admin/clinics" class="btn btn-primary">View All Clinics</a>
    </div>
</div>

