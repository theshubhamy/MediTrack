<div>
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Admin Dashboard</h1>
            <p class="text-gray-600 mt-2">System-wide statistics and management</p>
        </div>
        <div class="flex gap-2 flex-wrap items-center">
            <div class="flex gap-2 items-center">
                <select id="periodFilter" class="px-4 py-2 border border-gray-300 rounded-lg"
                    data-tooltip="Select time period for growth metrics">
                    <option value="7" <%=typeof growth !=='undefined' && growth.period===7 ? 'selected' : '' %>>Last 7 days</option>
                    <option value="30" <%=typeof growth !=='undefined' && growth.period===30 ? 'selected' : '' %>>Last 30 days</option>
                    <option value="90" <%=typeof growth !=='undefined' && growth.period===90 ? 'selected' : '' %>>Last 90 days</option>
                    <option value="365" <%=typeof growth !=='undefined' && growth.period===365 ? 'selected' : '' %>>Last year</option>
                    <option value="custom" <%=typeof growth !=='undefined' && growth.isCustomRange ? 'selected' : '' %>>Custom Range</option>
                </select>
                <div id="customDateRange" class="hidden flex gap-2 items-center">
                    <input type="date" id="startDate" class="px-4 py-2 border border-gray-300 rounded-lg"
                        value="<%=typeof growth !=='undefined' && growth.startDate ? growth.startDate : '' %>"
                        data-tooltip="Start date">
                    <span class="text-gray-600">to</span>
                    <input type="date" id="endDate" class="px-4 py-2 border border-gray-300 rounded-lg"
                        value="<%=typeof growth !=='undefined' && growth.endDate ? growth.endDate : '' %>"
                        data-tooltip="End date">
                    <button id="applyDateRange" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
                        Apply
                    </button>
                </div>
            </div>
            <a href="/admin/analytics"
                class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
                data-tooltip="View detailed analytics and charts">
                📊 Advanced Analytics
            </a>
        </div>
    </div>

    <!-- System Health Status -->
    <% if (typeof systemHealth !=='undefined' ) { %>
        <div class="mb-6 bg-white rounded-lg shadow-md p-4 border-l-4 border-green-500 card-hover"
            data-tooltip="Current system status and resource usage">
            <div class="flex items-center justify-between flex-wrap gap-4">
                <div>
                    <h3 class="text-lg font-semibold text-gray-900">System Health</h3>
                    <p class="text-sm text-gray-600">Status: <span class="text-green-600 font-medium">Healthy</span></p>
                </div>
                <div class="text-right text-sm text-gray-600">
                    <p>Uptime: <%= Math.floor(systemHealth.uptime / 3600) %>h <%= Math.floor((systemHealth.uptime %
                                3600) / 60) %>m</p>
                    <p>Memory: <%= Math.round(systemHealth.memory.heapUsed / 1024 / 1024) %>MB / <%=
                                Math.round(systemHealth.memory.heapTotal / 1024 / 1024) %>MB</p>
                </div>
            </div>
        </div>
        <% } %>

            <!-- Statistics Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                <div class="stat-card card-hover" data-tooltip="Total number of clinics in the system">
                    <div class="text-4xl">🏥</div>
                    <div>
                        <h3 class="text-3xl font-bold text-gray-900">
                            <%= stats.totalClinics %>
                        </h3>
                        <p class="text-gray-600 text-sm">Total Clinics</p>
                        <% if (typeof growth !=='undefined' && growth.newClinics> 0) { %>
                            <p class="text-xs text-green-600 mt-1">+<%= growth.newClinics %> new</p>
                            <% } %>
                    </div>
                </div>

                <div class="stat-card card-hover" data-tooltip="Clinics with active subscriptions">
                    <div class="text-4xl">✅</div>
                    <div>
                        <h3 class="text-3xl font-bold text-gray-900">
                            <%= stats.activeClinics %>
                        </h3>
                        <p class="text-gray-600 text-sm">Active Clinics</p>
                    </div>
                </div>

                <div class="stat-card card-hover" data-tooltip="Total users across all clinics">
                    <div class="text-4xl">👥</div>
                    <div>
                        <h3 class="text-3xl font-bold text-gray-900">
                            <%= stats.totalUsers %>
                        </h3>
                        <p class="text-gray-600 text-sm">Total Users</p>
                        <% if (typeof growth !=='undefined' && growth.newUsers> 0) { %>
                            <p class="text-xs text-green-600 mt-1">+<%= growth.newUsers %> new</p>
                            <% } %>
                    </div>
                </div>

                <div class="stat-card card-hover" data-tooltip="Total patients registered in the system">
                    <div class="text-4xl">📋</div>
                    <div>
                        <h3 class="text-3xl font-bold text-gray-900">
                            <%= stats.totalPatients %>
                        </h3>
                        <p class="text-gray-600 text-sm">Total Patients</p>
                        <% if (typeof growth !=='undefined' && growth.newPatients> 0) { %>
                            <p class="text-xs text-green-600 mt-1">+<%= growth.newPatients %> new</p>
                            <% } %>
                    </div>
                </div>

            </div>

            <!-- Charts and Analytics -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                <!-- Daily Visits Chart -->
                <% if (typeof analytics !=='undefined' && analytics.dailyStats && analytics.dailyStats.length> 0) { %>
                    <div class="card card-hover" data-tooltip="Daily visit statistics for the selected period">
                        <h2 class="text-2xl font-bold text-gray-900 mb-4">Daily Visits (Last <%= typeof growth
                                !=='undefined' ? growth.period : 30 %> days)</h2>
                        <div class="h-64 flex items-end justify-between gap-1">
                            <% const counts=analytics.dailyStats.map(s=> parseInt(s.count) || 0);
                                const maxCount = counts.length > 0 ? Math.max(...counts) : 0;
                                analytics.dailyStats.forEach(stat => {
                                const count = parseInt(stat.count) || 0;
                                const height = maxCount > 0 ? (count / maxCount) * 100 : 0;
                                const heightPx = Math.max(0, height).toFixed(2) + 'px';
                                %>
                                <div class="flex-1 flex flex-col items-center">
                                    <div class="w-full bg-blue-500 rounded-t hover:bg-blue-600 transition-colors"
                                        style="--bar-height: <%= heightPx %>; height: var(--bar-height); min-height: 2px;"
                                        title="<%= stat.date %>: <%= stat.count %> visits">
                                    </div>
                                    <span
                                        class="text-xs text-gray-500 mt-2 transform -rotate-45 origin-top-left whitespace-nowrap">
                                        <%= new Date(stat.date).toLocaleDateString('en-US', { month: 'short' ,
                                            day: 'numeric' }) %>
                                    </span>
                                </div>
                                <% }); %>
                        </div>
                    </div>
                    <% } %>

                        <!-- User Role Distribution -->
                        <% if (typeof analytics !=='undefined' && analytics.userRoleDistribution &&
                            analytics.userRoleDistribution.length> 0) { %>
                            <div class="card card-hover" data-tooltip="Distribution of users by role">
                                <h2 class="text-2xl font-bold text-gray-900 mb-4">User Role Distribution</h2>
                                <div class="space-y-4">
                                    <% analytics.userRoleDistribution.forEach(item=> {
                                        const widthPercent = ((parseInt(item.count) / stats.totalUsers) *
                                        100).toFixed(2) + '%';
                                        %>
                                        <div>
                                            <div class="flex justify-between mb-1">
                                                <span class="text-sm font-medium text-gray-700">
                                                    <%= item.role.replace('_', ' ' ) %>
                                                </span>
                                                <span class="text-sm font-bold text-gray-900">
                                                    <%= item.count %>
                                                </span>
                                            </div>
                                            <div class="w-full bg-gray-200 rounded-full h-2">
                                                <div class="bg-blue-600 h-2 rounded-full"
                                                    style="--bar-width: <%= widthPercent %>; width: var(--bar-width);">
                                                </div>
                                            </div>
                                        </div>
                                        <% }); %>
                                </div>
                            </div>
                            <% } %>
            </div>

            <!-- Main Content Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                <!-- Recent Clinics -->
                <div class="card card-hover" data-tooltip="Most recently registered clinics">
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-2xl font-bold text-gray-900">Recent Clinics</h2>
                        <a href="/admin/clinics" class="text-sm text-blue-600 hover:text-blue-700"
                            data-tooltip="View all clinics">View All →</a>
                    </div>
                    <% if (recentClinics.length===0) { %>
                        <div class="empty-state">
                            <p>No clinics found.</p>
                        </div>
                        <% } else { %>
                            <div class="overflow-x-auto">
                                <table class="min-w-full divide-y divide-gray-200">
                                    <thead class="bg-gray-50">
                                        <tr>
                                            <th
                                                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                Name</th>
                                            <th
                                                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                Plan</th>
                                            <th
                                                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                Status</th>
                                            <th
                                                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                Created</th>
                                            <th
                                                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody class="bg-white divide-y divide-gray-200">
                                        <% recentClinics.forEach(clinic=> { %>
                                            <tr class="hover:bg-gray-50">
                                                <td
                                                    class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                                    <%= clinic.name %>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                                    <span
                                                        class="px-2 py-1 text-xs rounded-full bg-blue-100 text-blue-800">
                                                        <%= clinic.plan %>
                                                    </span>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                                    <span
                                                        class="px-2 py-1 text-xs rounded-full <%= clinic.subscriptionStatus === 'ACTIVE' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                                                        <%= clinic.subscriptionStatus %>
                                                    </span>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                                    <%= new Date(clinic.created_at).toLocaleDateString() %>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                                    <a href="/admin/clinics/<%= clinic.id %>"
                                                        class="btn btn-sm">View</a>
                                                </td>
                                            </tr>
                                            <% }); %>
                                    </tbody>
                                </table>
                            </div>
                            <% } %>
                </div>

                <!-- Clinics by Plan -->
                <div class="card card-hover" data-tooltip="Distribution of clinics by subscription plan">
                    <h2 class="text-2xl font-bold text-gray-900 mb-6">Clinics by Plan</h2>
                    <% if (typeof analytics !=='undefined' && analytics.clinicsByPlan && analytics.clinicsByPlan.length>
                        0) { %>
                        <div class="space-y-4">
                            <% analytics.clinicsByPlan.forEach(item=> { %>
                                <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                                    <span class="text-sm font-medium text-gray-700">
                                        <%= item.plan %>
                                    </span>
                                    <span class="text-2xl font-bold text-gray-900">
                                        <%= item.count %>
                                    </span>
                                </div>
                                <% }); %>
                        </div>
                        <% } else { %>
                            <div class="empty-state">
                                <p>No data available.</p>
                            </div>
                            <% } %>
                </div>
            </div>

            <!-- Most Active Clinics -->
            <% if (typeof analytics !=='undefined' && analytics.mostActiveClinics && analytics.mostActiveClinics.length>
                0) { %>
                <div class="card card-hover mb-8" data-tooltip="Clinics with the highest number of visits">
                    <h2 class="text-2xl font-bold text-gray-900 mb-6">Most Active Clinics</h2>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th
                                        class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Clinic</th>
                                    <th
                                        class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Plan</th>
                                    <th
                                        class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Status</th>
                                    <th
                                        class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Visits</th>
                                    <th
                                        class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Actions</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                <% analytics.mostActiveClinics.forEach(clinic=> { %>
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                            <%= clinic.name %>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                                            <span class="px-2 py-1 text-xs rounded-full bg-blue-100 text-blue-800">
                                                <%= clinic.plan %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                                            <span
                                                class="px-2 py-1 text-xs rounded-full <%= clinic.subscriptionStatus === 'ACTIVE' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                                                <%= clinic.subscriptionStatus %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900">
                                            <%= clinic.visitCount || 0 %>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                                            <a href="/admin/clinics/<%= clinic.id %>" class="btn btn-sm">View</a>
                                        </td>
                                    </tr>
                                    <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <% } %>

                    <!-- Quick Actions -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                        <a href="/admin/users" class="card card-hover text-center"
                            data-tooltip="Manage all system users (Press U)">
                            <div class="text-4xl mb-2">👥</div>
                            <h3 class="font-semibold text-gray-900">User Management</h3>
                            <p class="text-sm text-gray-600 mt-1">Manage all users</p>
                            <div class="mt-2">
                                <span class="keyboard-shortcut"><kbd class="key">U</kbd></span>
                            </div>
                        </a>
                        <a href="/admin/clinics" class="card card-hover text-center"
                            data-tooltip="View and manage all clinics (Press C)">
                            <div class="text-4xl mb-2">🏥</div>
                            <h3 class="font-semibold text-gray-900">Clinic Management</h3>
                            <p class="text-sm text-gray-600 mt-1">View all clinics</p>
                            <div class="mt-2">
                                <span class="keyboard-shortcut"><kbd class="key">C</kbd></span>
                            </div>
                        </a>
                        <a href="/admin/analytics" class="card card-hover text-center"
                            data-tooltip="View detailed analytics and charts (Press A)">
                            <div class="text-4xl mb-2">📊</div>
                            <h3 class="font-semibold text-gray-900">Analytics</h3>
                            <p class="text-sm text-gray-600 mt-1">View detailed analytics</p>
                            <div class="mt-2">
                                <span class="keyboard-shortcut"><kbd class="key">A</kbd></span>
                            </div>
                        </a>
                        <a href="/admin/export/clinics" class="card card-hover text-center"
                            data-tooltip="Export data to CSV format">
                            <div class="text-4xl mb-2">📥</div>
                            <h3 class="font-semibold text-gray-900">Export Data</h3>
                            <p class="text-sm text-gray-600 mt-1">Export to CSV</p>
                        </a>
                    </div>
</div>

<script>
    // Period filter
    const periodFilter = document.getElementById('periodFilter');
    const customDateRange = document.getElementById('customDateRange');
    const startDateInput = document.getElementById('startDate');
    const endDateInput = document.getElementById('endDate');
    const applyDateRangeBtn = document.getElementById('applyDateRange');

    // Show/hide custom date range based on selection
    periodFilter?.addEventListener('change', function () {
        if (this.value === 'custom') {
            customDateRange.classList.remove('hidden');
            // Set default dates if not set
            if (!startDateInput.value) {
                const endDate = new Date();
                const startDate = new Date();
                startDate.setDate(startDate.getDate() - 30);
                startDateInput.value = startDate.toISOString().split('T')[0];
                endDateInput.value = endDate.toISOString().split('T')[0];
            }
        } else {
            customDateRange.classList.add('hidden');
            // Apply period filter immediately
            window.location.href = `/admin?period=${this.value}`;
        }
    });

    // Apply custom date range
    applyDateRangeBtn?.addEventListener('click', function () {
        const startDate = startDateInput.value;
        const endDate = endDateInput.value;

        if (!startDate || !endDate) {
            alert('Please select both start and end dates');
            return;
        }

        if (new Date(startDate) > new Date(endDate)) {
            alert('Start date must be before end date');
            return;
        }

        window.location.href = `/admin?start_date=${startDate}&end_date=${endDate}`;
    });

    // Show custom date range if it's already selected
    <% if (typeof growth !== 'undefined' && growth.isCustomRange) { %>
        if (customDateRange) customDateRange.classList.remove('hidden');
    <% } %>
</script>
