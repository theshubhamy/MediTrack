<div>
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Clinic Health Dashboard</h1>
            <p class="text-gray-600 mt-2"><%= clinic.name %></p>
        </div>
        <div class="flex gap-2">
            <a href="/admin/clinics/<%= clinic.id %>" class="btn btn-secondary">View Clinic Details</a>
            <a href="/admin/clinics" class="btn btn-secondary">Back to Clinics</a>
        </div>
    </div>

    <!-- Health Score -->
    <div class="card mb-6">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-2xl font-bold text-gray-900 mb-2">Health Score</h2>
                <p class="text-gray-600">
                    <% if (healthScore >= 80) { %>
                        <span class="text-green-600 font-medium">Excellent</span>
                    <% } else if (healthScore >= 60) { %>
                        <span class="text-yellow-600 font-medium">Good</span>
                    <% } else if (healthScore >= 40) { %>
                        <span class="text-orange-600 font-medium">Fair</span>
                    <% } else { %>
                        <span class="text-red-600 font-medium">Poor</span>
                    <% } %>
                </p>
            </div>
            <div class="text-6xl font-bold <%= healthScore >= 80 ? 'text-green-600' : healthScore >= 60 ? 'text-yellow-600' : healthScore >= 40 ? 'text-orange-600' : 'text-red-600' %>">
                <%= healthScore %>
            </div>
        </div>
        <div class="mt-4">
            <div class="w-full bg-gray-200 rounded-full h-4">
                <div class="<%= healthScore >= 80 ? 'bg-green-600' : healthScore >= 60 ? 'bg-yellow-600' : healthScore >= 40 ? 'bg-orange-600' : 'bg-red-600' %> h-4 rounded-full transition-all"
                     style="--bar-width: <%= healthScore %>%; width: var(--bar-width);"></div>
            </div>
        </div>
    </div>

    <!-- Statistics -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-8">
        <div class="stat-card">
            <div class="text-4xl">👥</div>
            <div>
                <h3 class="text-3xl font-bold text-gray-900"><%= stats.activeUsers %></h3>
                <p class="text-gray-600 text-sm">Active Users</p>
                <p class="text-xs text-gray-500 mt-1"><%= stats.totalUsers %> total</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="text-4xl">📋</div>
            <div>
                <h3 class="text-3xl font-bold text-gray-900"><%= stats.patientCount %></h3>
                <p class="text-gray-600 text-sm">Patients</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="text-4xl">📊</div>
            <div>
                <h3 class="text-3xl font-bold text-gray-900"><%= stats.visitCount %></h3>
                <p class="text-gray-600 text-sm">Visits</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="text-4xl">📅</div>
            <div>
                <h3 class="text-3xl font-bold text-gray-900"><%= stats.appointmentCount %></h3>
                <p class="text-gray-600 text-sm">Appointments</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="text-4xl">💳</div>
            <div>
                <h3 class="text-2xl font-bold text-gray-900"><%= clinic.plan %></h3>
                <p class="text-gray-600 text-sm">Plan</p>
                <p class="text-xs <%= clinic.subscriptionStatus === 'ACTIVE' ? 'text-green-600' : 'text-red-600' %> mt-1">
                    <%= clinic.subscriptionStatus %>
                </p>
            </div>
        </div>
    </div>

    <!-- Clinic Information -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <div class="card">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Clinic Information</h2>
            <div class="space-y-3">
                <div class="flex justify-between py-2 border-b border-gray-200">
                    <span class="text-sm font-medium text-gray-700">Name</span>
                    <span class="text-sm text-gray-900"><%= clinic.name %></span>
                </div>
                <div class="flex justify-between py-2 border-b border-gray-200">
                    <span class="text-sm font-medium text-gray-700">Email</span>
                    <span class="text-sm text-gray-900"><%= clinic.email %></span>
                </div>
                <div class="flex justify-between py-2 border-b border-gray-200">
                    <span class="text-sm font-medium text-gray-700">Phone</span>
                    <span class="text-sm text-gray-900"><%= clinic.phone || '-' %></span>
                </div>
                <div class="flex justify-between py-2 border-b border-gray-200">
                    <span class="text-sm font-medium text-gray-700">Plan</span>
                    <span class="text-sm text-gray-900"><%= clinic.plan %></span>
                </div>
                <div class="flex justify-between py-2">
                    <span class="text-sm font-medium text-gray-700">Status</span>
                    <span class="px-2 py-1 text-xs rounded-full <%= clinic.subscriptionStatus === 'ACTIVE' ? 'bg-green-100 text-green-800' : clinic.subscriptionStatus === 'SUSPENDED' ? 'bg-red-100 text-red-800' : 'bg-gray-100 text-gray-800' %>">
                        <%= clinic.subscriptionStatus %>
                    </span>
                </div>
            </div>
        </div>

        <div class="card">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Quick Actions</h2>
            <div class="space-y-3">
                <form method="POST" action="/admin/clinics/<%= clinic.id %>/plan" class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Change Plan</label>
                    <div class="flex gap-2">
                        <select name="plan" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg">
                            <option value="FREE" <%= clinic.plan === 'FREE' ? 'selected' : '' %>>Free</option>
                            <option value="STARTER" <%= clinic.plan === 'STARTER' ? 'selected' : '' %>>Starter</option>
                            <option value="CLINIC" <%= clinic.plan === 'CLINIC' ? 'selected' : '' %>>Clinic</option>
                            <option value="PRO" <%= clinic.plan === 'PRO' ? 'selected' : '' %>>Pro</option>
                        </select>
                        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                            Update
                        </button>
                    </div>
                </form>
                <form method="POST" action="/admin/clinics/<%= clinic.id %>/status">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Change Status</label>
                    <div class="flex gap-2">
                        <select name="subscriptionStatus" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg">
                            <option value="ACTIVE" <%= clinic.subscriptionStatus === 'ACTIVE' ? 'selected' : '' %>>Active</option>
                            <option value="INACTIVE" <%= clinic.subscriptionStatus === 'INACTIVE' ? 'selected' : '' %>>Inactive</option>
                            <option value="SUSPENDED" <%= clinic.subscriptionStatus === 'SUSPENDED' ? 'selected' : '' %>>Suspended</option>
                        </select>
                        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                            Update
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Recent Visits -->
    <% if (recentVisits && recentVisits.length > 0) { %>
        <div class="card">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Recent Visits</h2>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Patient</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Doctor</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Diagnosis</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% recentVisits.forEach(visit => { %>
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <%= new Date(visit.created_at).toLocaleDateString() %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                    <%= visit.patient ? visit.patient.name : '-' %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <%= visit.doctor ? visit.doctor.name : '-' %>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-700">
                                    <%= visit.diagnosis ? (visit.diagnosis.length > 50 ? visit.diagnosis.substring(0, 50) + '...' : visit.diagnosis) : '-' %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>
</div>

