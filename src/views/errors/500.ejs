<div class="text-center py-16">
    <h1 class="text-6xl font-bold text-red-600 mb-4">500</h1>
    <p class="text-xl text-gray-600 mb-8">Internal Server Error</p>
    <% if (typeof error !== 'undefined' && error && typeof NODE_ENV !== 'undefined' && NODE_ENV === 'development') { %>
    <div class="max-w-2xl mx-auto mb-8">
        <pre class="bg-gray-100 p-4 rounded-md text-left text-sm overflow-auto"><%= JSON.stringify(error, null, 2) %></pre>
    </div>
    <% } %>
    <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
</div>

