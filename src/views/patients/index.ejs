<div>
    <div class="page-header">
        <h1 class="text-3xl font-bold text-gray-900">Patients</h1>
        <% if (typeof canCreateVisits !== 'undefined' && canCreateVisits()) { %>
        <a href="/patients/new" class="btn btn-primary">Add New Patient</a>
        <% } %>
    </div>

    <div class="card mb-6">
        <form method="GET" action="/patients" class="flex gap-4">
            <input
                type="text"
                name="search"
                placeholder="Search by name or phone..."
                value="<%= search %>"
                class="form-input flex-1"
            >
            <button type="submit" class="btn btn-secondary">Search</button>
        </form>
    </div>

    <% if (patients.length === 0) { %>
    <div class="empty-state">
        <p>No patients found. <a href="/patients/new" class="text-blue-600 hover:text-blue-700">Add your first patient</a></p>
    </div>
    <% } else { %>
    <div class="card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Phone</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Age</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Gender</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    <% patients.forEach(patient => { %>
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                            <a href="/patients/<%= patient.id %>" class="text-blue-600 hover:text-blue-700 font-medium"><%= patient.name %></a>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= patient.phone || '-' %></td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= patient.age || '-' %></td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= patient.gender || '-' %></td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm space-x-2">
                            <a href="/patients/<%= patient.id %>" class="btn btn-sm">View</a>
                            <% if (typeof canCreateVisits !== 'undefined' && canCreateVisits()) { %>
                            <a href="/visits/new/<%= patient.id %>" class="btn btn-sm btn-primary">New Visit</a>
                            <% } %>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
    <% } %>
</div>

