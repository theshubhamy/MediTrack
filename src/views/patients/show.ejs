<div>
    <div class="page-header">
        <h1 class="text-3xl font-bold text-gray-900"><%= patient.name %></h1>
        <% if (typeof canCreateVisits !== 'undefined' && canCreateVisits()) { %>
        <a href="/visits/new/<%= patient.id %>" class="btn btn-primary">New Visit</a>
        <% } %>
    </div>

    <div class="card mb-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Patient Information</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
                <label class="text-sm font-medium text-gray-500">Phone</label>
                <p class="mt-1 text-gray-900"><%= patient.phone || '-' %></p>
            </div>
            <div>
                <label class="text-sm font-medium text-gray-500">Age</label>
                <p class="mt-1 text-gray-900"><%= patient.age || '-' %></p>
            </div>
            <div>
                <label class="text-sm font-medium text-gray-500">Gender</label>
                <p class="mt-1 text-gray-900"><%= patient.gender || '-' %></p>
            </div>
        </div>
    </div>

    <div class="card">
        <h2 class="text-xl font-semibold text-gray-900 mb-6">Visit History</h2>
        <% if (patient.visits.length === 0) { %>
        <div class="empty-state">
            <p>
                No visits yet.
                <% if (typeof canCreateVisits !== 'undefined' && canCreateVisits()) { %>
                <a href="/visits/new/<%= patient.id %>" class="text-blue-600 hover:text-blue-700">Create first visit</a>
                <% } %>
            </p>
        </div>
        <% } else { %>
        <div class="space-y-4">
            <% patient.visits.forEach(visit => { %>
            <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
                <div class="flex justify-between items-center mb-4 pb-4 border-b border-gray-200">
                    <span class="font-semibold text-gray-900"><%= new Date(visit.createdAt).toLocaleDateString() %></span>
                    <span class="text-sm text-gray-600">Dr. <%= visit.doctor.name %></span>
                </div>
                <% if (visit.diagnosis) { %>
                <div class="mb-3">
                    <strong class="text-gray-700">Diagnosis:</strong>
                    <p class="text-gray-900 mt-1"><%= visit.diagnosis %></p>
                </div>
                <% } %>
                <% if (visit.symptoms) { %>
                <div class="mb-4">
                    <strong class="text-gray-700">Symptoms:</strong>
                    <p class="text-gray-900 mt-1"><%= visit.symptoms %></p>
                </div>
                <% } %>
                <div>
                    <a href="/visits/<%= visit.id %>" class="btn btn-sm">View Details</a>
                </div>
            </div>
            <% }); %>
        </div>
        <% } %>
    </div>
</div>

