<div>
    <!-- Header Section -->
    <div class="mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl p-4">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">
                        <%= patient.name %>
                    </h1>
                    <p class="text-gray-600 mt-1">Patient Profile</p>
                </div>
            </div>
            <% if (typeof canCreateVisits !=='undefined' && canCreateVisits()) { %>
                <a href="/visits/new/<%= patient.id %>"
                    class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium shadow-sm">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    New Visit
                </a>
                <% } %>
        </div>
    </div>

    <!-- Patient Information Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <!-- Phone Card -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="flex items-center gap-4">
                <div class="bg-blue-100 rounded-lg p-3">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z">
                        </path>
                    </svg>
                </div>
                <div class="flex-1">
                    <p class="text-sm font-medium text-gray-500 uppercase tracking-wide">Phone</p>
                    <p class="text-lg font-semibold text-gray-900 mt-1">
                        <% if (patient.phone) { %>
                            <%= patient.phone %>
                                <% } else { %>
                                    <span class="text-gray-400">Not provided</span>
                                    <% } %>
                    </p>
                </div>
            </div>
        </div>

        <!-- Age Card -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="flex items-center gap-4">
                <div class="bg-green-100 rounded-lg p-3">
                    <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z">
                        </path>
                    </svg>
                </div>
                <div class="flex-1">
                    <p class="text-sm font-medium text-gray-500 uppercase tracking-wide">Age</p>
                    <p class="text-lg font-semibold text-gray-900 mt-1">
                        <% if (patient.age) { %>
                            <%= patient.age %> years
                                <% } else { %>
                                    <span class="text-gray-400">Not provided</span>
                                    <% } %>
                    </p>
                </div>
            </div>
        </div>

        <!-- Gender Card -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="flex items-center gap-4">
                <div class="bg-purple-100 rounded-lg p-3">
                    <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                        </path>
                    </svg>
                </div>
                <div class="flex-1">
                    <p class="text-sm font-medium text-gray-500 uppercase tracking-wide">Gender</p>
                    <p class="text-lg font-semibold text-gray-900 mt-1">
                        <% if (patient.gender) { %>
                            <%= patient.gender %>
                                <% } else { %>
                                    <span class="text-gray-400">Not provided</span>
                                    <% } %>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Patient Timeline Section -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-5 border-b border-gray-200 bg-gray-50">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h2 class="text-xl font-bold text-gray-900">Structured Patient Timeline</h2>
                    <p class="text-sm text-gray-600 mt-1">
                        <%= timeline.length %> <%= timeline.length === 1 ? 'touchpoint' : 'touchpoints' %> recorded (consultations & appointments)
                    </p>
                </div>
            </div>
        </div>

        <div class="p-6">
            <% if (timeline.length === 0) { %>
                <!-- Empty State -->
                <div class="text-center py-16">
                    <div class="inline-flex items-center justify-center w-20 h-20 bg-gray-100 rounded-full mb-4">
                        <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z">
                            </path>
                        </svg>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-900 mb-2">No timeline activities yet</h3>
                    <p class="text-gray-500 mb-6">Start tracking this patient's medical history by creating a visit or scheduling an appointment.</p>
                </div>
            <% } else { %>
                <!-- Timeline List -->
                <div class="relative border-l-2 border-gray-200 ml-4 md:ml-6 space-y-8 py-2">
                    <% timeline.forEach((item, index) => { %>
                        <div class="relative pl-8 md:pl-10">
                            <!-- Timeline Dot Icon -->
                            <div class="absolute -left-[17px] top-1 flex items-center justify-center w-8 h-8 rounded-full border-4 border-white shadow-sm
                                <%= item.type === 'VISIT' ? 'bg-green-500 text-white' : 
                                    item.status === 'SCHEDULED' ? 'bg-blue-500 text-white' : 
                                    item.status === 'CONFIRMED' ? 'bg-indigo-500 text-white' : 
                                    item.status === 'COMPLETED' ? 'bg-teal-500 text-white' : 
                                    item.status === 'CANCELLED' ? 'bg-red-500 text-white' : 
                                    'bg-gray-500 text-white' %>">
                                <% if (item.type === 'VISIT') { %>
                                    <span class="text-sm">🩺</span>
                                <% } else { %>
                                    <span class="text-xs">📅</span>
                                <% } %>
                            </div>

                            <!-- Timeline Card -->
                            <div class="bg-white border border-gray-200 rounded-xl p-5 hover:shadow-md transition-all duration-200 <%= index === 0 ? 'ring-2 ring-blue-100 bg-blue-50/10' : '' %>">
                                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-gray-100 pb-3 mb-4">
                                    <div class="flex items-center gap-3">
                                        <span class="px-2.5 py-1 text-xs font-semibold rounded-full 
                                            <%= item.type === 'VISIT' ? 'bg-green-100 text-green-800' : 
                                                item.status === 'SCHEDULED' ? 'bg-blue-100 text-blue-800' : 
                                                item.status === 'CONFIRMED' ? 'bg-indigo-100 text-indigo-800' : 
                                                item.status === 'COMPLETED' ? 'bg-teal-100 text-teal-800' : 
                                                item.status === 'CANCELLED' ? 'bg-red-100 text-red-800' : 
                                                'bg-gray-100 text-gray-800' %>">
                                            <%= item.type === 'VISIT' ? 'Consultation' : `Appointment: ${item.status}` %>
                                        </span>
                                        <span class="text-sm text-gray-500 font-medium">
                                            Dr. <%= item.doctorName %>
                                        </span>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-sm font-semibold text-gray-900">
                                            <%= new Date(item.date).toLocaleDateString('en-US', {
                                                year: 'numeric', month: 'long', day: 'numeric'
                                            }) %>
                                        </p>
                                        <p class="text-xs text-gray-500 mt-0.5">
                                            <%= new Date(item.date).toLocaleTimeString('en-US', {
                                                hour: '2-digit', minute: '2-digit'
                                            }) %>
                                        </p>
                                    </div>
                                </div>

                                <!-- Card Content -->
                                <% if (item.type === 'VISIT') { %>
                                    <!-- Visit Details -->
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <% if (item.symptoms) { %>
                                            <div>
                                                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Symptoms</p>
                                                <p class="text-sm text-gray-800"><%= item.symptoms %></p>
                                            </div>
                                        <% } %>
                                        <% if (item.diagnosis) { %>
                                            <div>
                                                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Diagnosis</p>
                                                <p class="text-sm text-gray-800"><%= item.diagnosis %></p>
                                            </div>
                                        <% } %>
                                    </div>
                                    <% if (item.notes) { %>
                                        <div class="mt-3">
                                            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Notes</p>
                                            <p class="text-sm text-gray-700 italic"><%= item.notes %></p>
                                        </div>
                                    <% } %>
                                    <% if (item.nextVisitDate) { %>
                                        <div class="mt-4 flex items-center gap-1.5 text-xs text-blue-600 font-medium bg-blue-50 px-3 py-1.5 rounded-lg w-max">
                                            <span>📅 Recommended Follow-up:</span>
                                            <span><%= new Date(item.nextVisitDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                                        </div>
                                    <% } %>
                                    
                                    <div class="mt-4 pt-3 border-t border-gray-100 flex gap-2">
                                        <a href="/visits/<%= item.id %>" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-xs font-semibold transition-colors">
                                            View Consultation
                                        </a>
                                        <% if (item.prescription) { %>
                                            <a href="/prescriptions/<%= item.prescription.id %>" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg text-xs font-semibold transition-colors">
                                                View Prescription
                                            </a>
                                        <% } %>
                                    </div>
                                <% } else { %>
                                    <!-- Appointment Details -->
                                    <div class="space-y-2">
                                        <% if (item.reason) { %>
                                            <div>
                                                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Reason for Visit</p>
                                                <p class="text-sm text-gray-800"><%= item.reason %></p>
                                            </div>
                                        <% } %>
                                        <% if (item.notes) { %>
                                            <div>
                                                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Administrative Notes</p>
                                                <p class="text-sm text-gray-600 italic"><%= item.notes %></p>
                                            </div>
                                        <% } %>
                                    </div>
                                    <div class="mt-4 pt-3 border-t border-gray-100">
                                        <a href="/appointments/<%= item.id %>" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-xs font-semibold transition-colors">
                                            Manage Appointment
                                        </a>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </div>
</div>
