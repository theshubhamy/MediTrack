<div>
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-900">
            <%= medicine ? 'Edit' : 'Add New' %> Medicine
        </h1>
        <p class="text-gray-600 mt-2">Manage medicine information</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
            <%= error %>
        </div>
    <% } %>

    <form method="POST" action="<%= medicine ? `/medicines/${medicine.id}` : '/medicines' %>" class="space-y-6">
        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Basic Information</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
                        Medicine Name <span class="text-red-500">*</span>
                    </label>
                    <input type="text" name="name" id="name" required
                        value="<%= medicine ? medicine.name : '' %>"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                </div>
                <div>
                    <label for="genericName" class="block text-sm font-medium text-gray-700 mb-2">
                        Generic Name
                    </label>
                    <input type="text" name="genericName" id="genericName"
                        value="<%= medicine ? medicine.genericName || '' : '' %>"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                </div>
                <div>
                    <label for="brandName" class="block text-sm font-medium text-gray-700 mb-2">
                        Brand Name
                    </label>
                    <input type="text" name="brandName" id="brandName"
                        value="<%= medicine ? medicine.brandName || '' : '' %>"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                </div>
                <div>
                    <label for="type" class="block text-sm font-medium text-gray-700 mb-2">
                        Type <span class="text-red-500">*</span>
                    </label>
                    <select name="type" id="type" required
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <option value="TABLET" <%= medicine && medicine.type === 'TABLET' ? 'selected' : '' %>>Tablet</option>
                        <option value="CAPSULE" <%= medicine && medicine.type === 'CAPSULE' ? 'selected' : '' %>>Capsule</option>
                        <option value="SYRUP" <%= medicine && medicine.type === 'SYRUP' ? 'selected' : '' %>>Syrup</option>
                        <option value="INJECTION" <%= medicine && medicine.type === 'INJECTION' ? 'selected' : '' %>>Injection</option>
                        <option value="DROPS" <%= medicine && medicine.type === 'DROPS' ? 'selected' : '' %>>Drops</option>
                        <option value="OINTMENT" <%= medicine && medicine.type === 'OINTMENT' ? 'selected' : '' %>>Ointment</option>
                        <option value="OTHER" <%= medicine && medicine.type === 'OTHER' ? 'selected' : '' %>>Other</option>
                    </select>
                </div>
                <div>
                    <label for="strength" class="block text-sm font-medium text-gray-700 mb-2">
                        Strength
                    </label>
                    <input type="text" name="strength" id="strength"
                        value="<%= medicine ? medicine.strength || '' : '' %>"
                        placeholder="e.g., 500mg, 10ml"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                </div>
                <div>
                    <label for="unit" class="block text-sm font-medium text-gray-700 mb-2">
                        Unit
                    </label>
                    <input type="text" name="unit" id="unit"
                        value="<%= medicine ? medicine.unit || 'mg' : 'mg' %>"
                        placeholder="mg, ml, etc."
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                </div>
                <div>
                    <label for="dosageForm" class="block text-sm font-medium text-gray-700 mb-2">
                        Dosage Form
                    </label>
                    <input type="text" name="dosageForm" id="dosageForm"
                        value="<%= medicine ? medicine.dosageForm || '' : '' %>"
                        placeholder="e.g., Oral, Topical, IV"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                </div>
                <% if (!medicine) { %>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            <input type="checkbox" name="isGlobal" value="true" class="mr-2">
                            Add as Global Medicine (available to all clinics)
                        </label>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Default Prescription Information</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label for="frequency" class="block text-sm font-medium text-gray-700 mb-2">
                        Default Frequency
                    </label>
                    <input type="text" name="frequency" id="frequency"
                        value="<%= medicine ? medicine.frequency || '' : '' %>"
                        placeholder="e.g., Once daily, Twice daily"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                </div>
                <div>
                    <label for="duration" class="block text-sm font-medium text-gray-700 mb-2">
                        Default Duration
                    </label>
                    <input type="text" name="duration" id="duration"
                        value="<%= medicine ? medicine.duration || '' : '' %>"
                        placeholder="e.g., 5 days, 1 week"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                </div>
            </div>
            <div class="mt-4">
                <label for="instructions" class="block text-sm font-medium text-gray-700 mb-2">
                    Default Instructions
                </label>
                <textarea name="instructions" id="instructions" rows="3"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    placeholder="Common instructions for this medicine..."><%= medicine ? medicine.instructions || '' : '' %></textarea>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Additional Information</h2>
            <div class="space-y-4">
                <div>
                    <label for="sideEffects" class="block text-sm font-medium text-gray-700 mb-2">
                        Side Effects
                    </label>
                    <textarea name="sideEffects" id="sideEffects" rows="3"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                        placeholder="Common side effects..."><%= medicine ? medicine.sideEffects || '' : '' %></textarea>
                </div>
                <div>
                    <label for="contraindications" class="block text-sm font-medium text-gray-700 mb-2">
                        Contraindications
                    </label>
                    <textarea name="contraindications" id="contraindications" rows="3"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                        placeholder="Contraindications..."><%= medicine ? medicine.contraindications || '' : '' %></textarea>
                </div>
                <% if (medicine) { %>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            <input type="checkbox" name="isActive" value="true"
                                <%= medicine.isActive ? 'checked' : '' %> class="mr-2">
                            Active
                        </label>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="flex gap-4">
            <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                <%= medicine ? 'Update' : 'Create' %> Medicine
            </button>
            <a href="/medicines" class="px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors">
                Cancel
            </a>
            <% if (medicine) { %>
                <form method="POST" action="/medicines/<%= medicine.id %>/delete" class="inline" onsubmit="return confirm('Are you sure you want to deactivate this medicine?');">
                    <button type="submit" class="px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">
                        Deactivate
                    </button>
                </form>
            <% } %>
        </div>
    </form>
</div>

